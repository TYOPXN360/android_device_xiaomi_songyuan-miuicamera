<permissions>
    <!--
         Mirrors the com.xiaomi.scanner entry of the stock pangu signature
         permission file. PackageManagerService refuses to boot when a
         privileged app requests a permission that is not allowlisted, so the
         stock set is reproduced verbatim rather than trimmed to the subset
         this device tree happened to need.
    -->
    <privapp-permissions package="com.xiaomi.scanner">
        <permission name="android.permission.MANAGE_EXTERNAL_STORAGE" />
        <permission name="android.permission.PACKAGE_USAGE_STATS" />
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE" />
        <permission name="android.permission.REQUEST_INSTALL_PACKAGES" />
        <permission name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />
        <permission name="android.permission.START_ANY_ACTIVITY" />
        <permission name="android.permission.STATUS_BAR" />
        <permission name="android.permission.SUBSCRIBE_TO_KEYGUARD_LOCKED_STATE" />
        <permission name="android.permission.SYSTEM_ALERT_WINDOW" />
        <permission name="android.permission.WRITE_SECURE_SETTINGS" />
        <permission name="android.permission.WRITE_SETTINGS" />
    </privapp-permissions>
</permissions>
