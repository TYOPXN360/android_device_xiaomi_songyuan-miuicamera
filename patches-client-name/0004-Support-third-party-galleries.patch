From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alex Zorzi <alleszorzi@gmail.com>
Date: Fri, 16 Oct 2026 19:26:00 +0200
Subject: [PATCH] Support third party galleries

Review the thumbnail with android.provider.action.REVIEW instead of
pinning it to com.miui.gallery, and open the empty-roll gallery through
APP_GALLERY in a new task.

Ported from myron's cupid-era 0002-0004; r4 -> I1/f1 and Camera.
---
 smali/I1/f1.smali                     | 8 ++------
 smali/com/android/camera/Camera.smali | 9 ++++++++-
 2 files changed, 10 insertions(+), 7 deletions(-)

diff --git a/smali/I1/f1.smali b/smali/I1/f1.smali
index 2d42eed..56deae7 100644
--- a/smali/I1/f1.smali
+++ b/smali/I1/f1.smali
@@ -87,7 +87,7 @@
 
     const-string v4, "GalleryHelper"
 
-    const-string v5, "com.android.camera.action.REVIEW"
+    const-string v5, "android.provider.action.REVIEW"
 
     if-eqz v1, :cond_1
 
@@ -155,7 +155,7 @@
     :cond_2
     new-array v1, v2, [Ljava/lang/Object;
 
-    const-string v6, "gotoGallery: com.android.camera.action.REVIEW"
+    const-string v6, "gotoGallery: android.provider.action.REVIEW"
 
     invoke-static {v4, v6, v1}, Lcom/android/camera/log/Log;->d(Ljava/lang/String;Ljava/lang/String;[Ljava/lang/Object;)V
 
@@ -164,10 +164,6 @@
     invoke-direct {v1, v5, p2}, Landroid/content/Intent;-><init>(Ljava/lang/String;Landroid/net/Uri;)V
 
     :goto_1
-    const-string p2, "com.miui.gallery"
-
-    invoke-virtual {v1, p2}, Landroid/content/Intent;->setPackage(Ljava/lang/String;)Landroid/content/Intent;
-
     const-string p2, "from_MiuiCamera"
 
     invoke-virtual {v1, p2, v3}, Landroid/content/Intent;->putExtra(Ljava/lang/String;Z)Landroid/content/Intent;
diff --git a/smali/com/android/camera/Camera.smali b/smali/com/android/camera/Camera.smali
index 7b8056d..e36090d 100644
--- a/smali/com/android/camera/Camera.smali
+++ b/smali/com/android/camera/Camera.smali
@@ -9415,7 +9415,14 @@
 
     invoke-direct {v0, v3}, Landroid/content/Intent;-><init>(Ljava/lang/String;)V
 
-    invoke-virtual {v0, v2}, Landroid/content/Intent;->setPackage(Ljava/lang/String;)Landroid/content/Intent;
+    const-string v3, "android.intent.category.APP_GALLERY"
+
+    invoke-virtual {v0, v3}, Landroid/content/Intent;->addCategory(Ljava/lang/String;)Landroid/content/Intent;
+
+    # FLAG_ACTIVITY_NEW_TASK
+    const/high16 v3, 0x10000000
+
+    invoke-virtual {v0, v3}, Landroid/content/Intent;->addFlags(I)Landroid/content/Intent;
 
     invoke-virtual {v6, v0}, Landroid/content/Context;->startActivity(Landroid/content/Intent;)V
 
-- 
